# ==============================================================================
# NumberGuard - Environment Configuration (.env.example)
# ==============================================================================

# Application & Environment
APP_NAME=NumberGuard
APP_ENV=development
APP_DEBUG=true
API_V1_STR=/api/v1
SECRET_KEY=change_this_to_a_cryptographically_secure_random_string_in_production_min_32_bytes
ACCESS_TOKEN_EXPIRE_MINUTES=480
ALGORITHM=HS256

# Privacy & Cryptography Salt
PHONE_HASH_PEPPER=change_this_pepper_to_a_secure_random_key_for_hmac_sha256_indexing

# Database Configuration
# In production / Docker Compose: postgresql+asyncpg://postgres:postgres@db:5432/numberguard
# Local developer default: SQLite fallback automatically enabled if postgres unavailable
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/numberguard
SYNC_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/numberguard
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=numberguard
POSTGRES_PORT=5432

# Redis & Background Queue
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Telecom Operator Defaults
DEFAULT_CARRIER=Jio
DEFAULT_COOLING_DAYS_STANDARD=60
DEFAULT_COOLING_DAYS_BANKING=90
DEFAULT_COOLING_DAYS_HIGH_RISK=120

# Risk Engine Weights & Thresholds
RISK_THRESHOLD_LOW=25
RISK_THRESHOLD_MEDIUM=55
RISK_THRESHOLD_HIGH=79
WEIGHT_BANKING_FINTECH=40
WEIGHT_RESPONSE_OVERDUE=25
WEIGHT_COOLING_INSUFFICIENT=20
WEIGHT_RECYCLING_VELOCITY=15

# Mock / Sandbox Integrations Mode
MOCK_EXTERNAL_SERVICES=true
SANDBOX_WEBHOOK_LATENCY_MS=300

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=NumberGuard
NEXT_PUBLIC_DEFAULT_TIMEZONE=Asia/Kolkata
